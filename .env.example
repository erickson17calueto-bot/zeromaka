# Copia para .env.local e preenche com os valores do teu projeto Supabase
# (Dashboard → Settings → API). A chave publishable/anon é pública por design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só de servidor — NUNCA prefixar com NEXT_PUBLIC_, nunca expor ao browser.
# Usada apenas em lib/supabase/admin.ts, para enviar o email de convite por
# auth.admin.inviteUserByEmail. Dashboard → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
